# SIEM Guardian yalnız Splunk alert log sağlığı için Management API kullanır.
# Splunk Web :8000 değildir. Management API adresi; erişim doğrulanmadı.
SPLUNK_BASE_URL=https://192.168.3.131:8089
# Token (Bearer) önceliklidir; alternatif olarak kullanıcı/parola doldurun.
SPLUNK_TOKEN=
SPLUNK_USERNAME=
SPLUNK_PASSWORD=
# Varsayılan TLS doğrulaması açık. Yalnız lab için açıkça false seçilebilir.
SPLUNK_VERIFY_TLS=true
# İsteğe bağlı özel CA sertifika dosyası (TLS doğrulaması açıkken):
SPLUNK_CA_BUNDLE=
HTTP_TIMEOUT_SECONDS=10
SEARCH_TIMEOUT_SECONDS=60
POLL_INTERVAL_SECONDS=1
